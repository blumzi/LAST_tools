#!/bin/bash

#
# This script produces manages the two LAST pipeline services
# 

PROG="$(basename "${0}")"

. /etc/profile.d/last.sh

module_include lib/message

function usage() {
    cat <<- EOF

    Show usage:
        ${PROG} [-h|--help]

    Options:
        -H|--host <host>   Act on this host (may be repeated; default: all deployed units)
        -n|--dry-run       Only print the last-asroot command that would be run

    Get status:
        ${PROG} [[-H host] ... ] [status]

    Turn on/off for the current system boot session (systemctl start/stop)
        ${PROG} [[-H host] ... ] on|start
        ${PROG} [[-H host] ... ] off|stop

    Always run/do-not-run the pipeline across system boots (systemctl enable/disable)
        ${PROG} [[-H host] ... ] always-on|enable
        ${PROG} [[-H host] ... ] always-off|disable

    Show the pipeline version (v0: pipeline.DemonLAST, v1: pipeline.last.pipes.PipelineDemon)
        ${PROG} [[-H host] ... ] version [id]

    Set the pipeline version for one data directory (needs a service restart)
        ${PROG} [[-H host] ... ] version id v0|v1

    Show the reference images directory ('auto' means /<host>/data/references)
        ${PROG} [[-H host] ... ] refpath [id]

    Set the reference images directory for one data directory (needs a service
    restart); '-' reverts to auto
        ${PROG} [[-H host] ... ] refpath id /path/to/references|-

EOF
}


if ! OPTS=$( getopt -o 'H:hun' --long "dry-run,help,host:,units,units-only" -n "${PROG}" -- "$@" ); then
    usage
    exit 1
fi
eval set -- "${OPTS}"


units_only=false
     hosts=()
   dry_run=false

while true; do
    case "${1}" in
    -n|--dry-run)
        dry_run=true
        shift 1
        ;;

    -u|--units|--units-only)
        units_only=true
        shift 1
        ;;

    -h|--help)
        usage
        exit 0
        ;;

    -H|--host)
        hosts+=( ${2} )
        shift 2
        ;;


    --)
        shift 1
        break
        ;;
    esac
done

action="${1}"

if [ ! "${action}" ]; then
    action=status
fi


case "${action}" in
    on)         action=start   ;;
    off)        action=stop    ;;
    always-on)  action=enable  ;;
    always-off) action=disable ;;
esac

case "${action}" in
    status|start|stop|enable|disable|version|refpath)
        ;;
    *)
        usage
        exit 1
        ;;
esac
        
cmd=""
case ${action} in
    status)
	cmd='source /etc/profile.d/last.sh; module_include lib/message; for service in last-pipeline{1,2}; do active=\$(systemctl is-active \${service}); enabled=\$(systemctl is-enabled \${service}); message_info \${service}: \${active} \${enabled}; done'
        ;;
    start)
        cmd='systemctl start last-pipeline{1,2}'
        ;;
    stop)
        cmd='systemctl stop last-pipeline{1,2}'
        ;;
    enable)
        cmd='systemctl enable last-pipeline{1,2}'
        ;;
    disable)
        cmd='systemctl disable last-pipeline{1,2}'
        ;;
    version)
        service=/usr/local/share/last-tool/bin/last-pipeline-service
        id="${2}"
        version="${3}"
        if [ "${id}" ] && [[ ! "${id}" =~ ^[0-9]+$ ]]; then
            usage
            exit 1
        fi
        if [ "${version}" ]; then
            if [ ! "${id}" ]; then
                usage
                exit 1
            fi
            cmd="${service} set-version ${id} ${version}"
        else
            cmd="${service} version ${id}"
        fi
        ;;
    refpath)
        service=/usr/local/share/last-tool/bin/last-pipeline-service
        id="${2}"
        refpath="${3}"
        if [ "${id}" ] && [[ ! "${id}" =~ ^[0-9]+$ ]]; then
            usage
            exit 1
        fi
        if [ "${refpath}" ]; then
            if [ ! "${id}" ]; then
                usage
                exit 1
            fi
            cmd="${service} set-refpath ${id} ${refpath}"
        else
            cmd="${service} refpath ${id}"
        fi
        ;;
esac

if [ "${hosts[*]}" ]; then
    hosts_arg=""
    for host in ${hosts[*]}; do
        hosts_arg+=" -H ${host}"
    done
else
    hosts_arg="-u"
fi

if ${dry_run}; then
    echo last-asroot ${hosts_arg} --cmd "${cmd}"
else
    last-asroot ${hosts_arg} --cmd "${cmd}"
fi
