#!/bin/bash

#
# This script produces manages the two LAST pipeline services
# 

PROG="$(basename "${0}")"

. /etc/profile.d/last.sh

module_include lib/message

function usage() {
    cat <<- EOF

    Show usage:
        ${PROG} [-h|--help] 

    Get status:
        ${PROG} [[-H host] ... ] [status]

    Turn on/off for the current system boot session
        ${PROG} [[-H host] ... ] on|off

    Always run/do-not-run the pipeline (across system boots)
        ${PROG} [[-H host] ... ] always-on|always-off 

    Show the pipeline version (v0: pipeline.DemonLAST, v1: pipeline.last.pipes.PipelineDemon)
        ${PROG} [[-H host] ... ] version [id]

    Set the pipeline version for one data directory (needs a service restart)
        ${PROG} [[-H host] ... ] version id v0|v1

EOF
}


OPTS=$( getopt -o 'H:hun' --long "dry-run,help,host:,units,units-only" -n "${PROG}" -- "$@" )
eval set -- "${OPTS}"


units_only=false
     hosts=()
   dry_run=false

while true; do
    case "${1}" in
    -n|--dry-run)
        dry_run=true
        shift 1
        ;;

    -u|--units|--units-only)
        units_only=true
        shift 1
        ;;

    -h|--help)
        usage
        exit 0
        ;;

    -H|--host)
        hosts+=( ${2} )
        shift 2
        ;;


    --)
        shift 1
        break
        ;;
    esac
done

action="${1}"

if [ ! "${action}" ]; then
    action=status
fi


case "${action}" in
    status|start|stop|enable|disable|version)
        ;;
    *)
        usage
        exit 1
        ;;
esac
        
cmd=""
case ${action} in
    status)
	cmd='source /etc/profile.d/last.sh; module_include lib/message; for service in last-pipeline{1,2}; do active=\$(systemctl is-active \${service}); enabled=\$(systemctl is-enabled \${service}); message_info \${service}: \${active} \${enabled}; done'
        ;;
    start)
        cmd='systemctl start last-pipeline{1,2}'
        ;;
    stop)
        cmd='systemctl stop last-pipeline{1,2}'
        ;;
    enable)
        cmd='systemctl enable last-pipeline{1,2}'
        ;;
    disable)
        cmd='systemctl disable last-pipeline{1,2}'
        ;;
    version)
        service=/usr/local/share/last-tool/bin/last-pipeline-service
        id="${2}"
        version="${3}"
        if [ "${id}" ] && [[ ! "${id}" =~ ^[0-9]+$ ]]; then
            usage
            exit 1
        fi
        if [ "${version}" ]; then
            if [ ! "${id}" ]; then
                usage
                exit 1
            fi
            cmd="${service} set-version ${id} ${version}"
        else
            cmd="${service} version ${id}"
        fi
        ;;
esac

if [ "${hosts[*]}" ]; then
    hosts_arg=""
    for host in ${hosts[*]}; do
        hosts_arg+=" -H ${host}"
    done
else
    hosts_arg="-u"
fi

if ${dry_run}; then
    echo last-asroot ${hosts_arg} --cmd "${cmd}"
else
    last-asroot ${hosts_arg} --cmd "${cmd}"
fi
