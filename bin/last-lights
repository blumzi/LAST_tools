#!/bin/bash

# vim:se nu ai terse nows ts=4 sts=4 sw=4 expandtab nohlsearch:

# shellcheck disable=SC1091
source /etc/profile.d/last.sh

PROG=$(basename "${0}")

# Written by Ansible (LAST_Ansible: playbooks/deploy/instruments/lights):
#   LIGHTS_SWITCH        address of the "last0 control" power switch
#   LIGHTS_OUTLET        the lights' outlet on it
#   LIGHTS_OID           eoPowerAdminState.<outlet> (RFC 7460)
#   LIGHTS_SNMPCONFPATH  directory holding the SNMPv3 credentials (powerLights)
LIGHTS_CONF=${LIGHTS_CONF:-/etc/last/lights.conf}

# IANA PowerStateSet (IEEE1621) values used by the switch
readonly STATE_ON=259
readonly STATE_OFF=257

function usage() {
    module_include lib/ansi

    cat <<- EOF

    At the LAST observatory (Neot Smadar) the lights (the light projectors)
     are powered by outlet #1 of the "last0 control" power switch.

    This tool controls that outlet over SNMP and lets the user:
     - Get the status of the lights
     - Turn the lights ON, OFF, or TOGGLE them

    $(ansi_underline "Usage"):
        ${PROG}
            - Shows whether the lights are on or off

        ${PROG} on|off|toggle
            - Turns the lights ON, OFF, or the opposite of what they are now

    $(ansi_bold "Notes"):
        - The switch user (powerLights) can switch the lights' outlet and
           nothing else on that switch.
        - Settings: ${LIGHTS_CONF} (installed by Ansible).

EOF
}

function die() {
    echo "${PROG}: ${*}" >&2
    exit 1
}

# snmp <snmpget|snmpset> [args...]: run against the switch with the
# powerLights credentials only (not the user's ~/.snmp or the system config).
function snmp() {
    local cmd=${1}
    shift
    SNMPCONFPATH="${LIGHTS_SNMPCONFPATH}" MIBS='' \
        "${cmd}" -t 2 -r 1 -Oqv "${LIGHTS_SWITCH}" "${@}"
}

# get_state: prints "on" or "off"; otherwise says why on stderr and returns 1.
# Always call it as `x=$(get_state) || exit 1`: it runs in a subshell, where
# an exit would not stop the script.
function get_state() {
    local value
    if ! value=$(snmp snmpget "${LIGHTS_OID}" 2>&1); then
        echo "${PROG}: cannot read the lights (${LIGHTS_SWITCH} outlet ${LIGHTS_OUTLET}): ${value}" >&2
        return 1
    fi
    case "${value}" in
        "${STATE_ON}")  echo on ;;
        "${STATE_OFF}") echo off ;;
        *)
            echo "${PROG}: unexpected answer for the lights (${LIGHTS_SWITCH} outlet ${LIGHTS_OUTLET}): ${value}" >&2
            return 1
            ;;
    esac
}

# set_state on|off: switches, then reads back and prints the result.
function set_state() {
    local want=${1} value out
    if [ "${want}" = on ]; then value=${STATE_ON}; else value=${STATE_OFF}; fi
    if ! out=$(snmp snmpset "${LIGHTS_OID}" i "${value}" 2>&1); then
        die "cannot switch the lights ${want} (${LIGHTS_SWITCH} outlet ${LIGHTS_OUTLET}): ${out}"
    fi
    sleep 1
    local now
    now=$(get_state) || exit 1
    if [ "${now}" != "${want}" ]; then
        die "asked for ${want}, but the lights read ${now}"
    fi
    echo "lights ${now}"
}

if [ "${1}" = '-h' ] || [ "${1}" = "--help" ]; then
    usage
    exit 0
fi

[ -r "${LIGHTS_CONF}" ] || die "${LIGHTS_CONF} is missing: deploy LAST_Ansible playbooks/deploy/instruments/lights"
# shellcheck disable=SC1090
source "${LIGHTS_CONF}"
[ -n "${LIGHTS_SWITCH}" ] && [ -n "${LIGHTS_OID}" ] || die "${LIGHTS_CONF} lacks LIGHTS_SWITCH or LIGHTS_OID"
[ -r "${LIGHTS_SNMPCONFPATH}/snmp.conf" ] || die "cannot read ${LIGHTS_SNMPCONFPATH}/snmp.conf (are you in group ocs?)"
command -v snmpget >/dev/null || die "snmpget is not installed (package snmp)"

if [ ${#} -gt 1 ]; then
    usage
    exit 1
fi

case "${1}" in
    '')
        state=$(get_state) || exit 1
        echo "lights ${state}"
        ;;
    on|off)
        set_state "${1}"
        ;;
    toggle)
        state=$(get_state) || exit 1
        if [ "${state}" = on ]; then set_state off; else set_state on; fi
        ;;
    *)
        echo "${PROG}: unknown action \"${1}\" (use on, off or toggle)" >&2
        usage
        exit 1
        ;;
esac
