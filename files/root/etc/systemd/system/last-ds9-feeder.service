[Unit]
Description=Feeds LAST images to ds9 viwer
# start only after the data disks are mounted: a camera's new/ folder that does not exist yet ends its
# inotifywait at once and that camera is never fed (LAST_tools #75)
RequiresMountsFor=/%H/data1 /%H/data2

[Service]
User=ocs
WorkingDirectory=/home/ocs
ExecStart=/usr/local/share/last-tool/bin/last-ds9-feeder start
ExecStop=pkill -f last-ds9-feeder
Restart=always

[Install]
WantedBy=multi-user.target
