[Unit]
Description=Refresh the IERS Earth orientation files used by AstroPack for the UTC to TT conversion
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ocs
# the nodes reach the internet only through the Weizmann proxy, which a systemd service does not inherit
Environment=http_proxy=http://bcproxy.weizmann.ac.il:8080
Environment=https_proxy=http://bcproxy.weizmann.ac.il:8080
ExecStart=/bin/bash /usr/local/share/last-tool/bin/last-iers-update
